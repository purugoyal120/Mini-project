{
  "openapi": "3.0.0",
  "info": {
    "title": "Core Banking Accounts Service",
    "version": "2.0.0",
    "description": "Modern digital wallet and account microservice"
  },
  "paths": {
    "/wallets": {
      "get": {
        "summary": "Retrieve digital wallet details (Migrated from /accounts)",
        "operationId": "getWallet",
        "responses": {
          "200": {
            "description": "Digital wallet details object",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "wallet_id": {
                      "type": "integer",
                      "example": 884920
                    },
                    "client_name": {
                      "type": "string",
                      "example": "Ashvary"
                    },
                    "balance": {
                      "type": "number",
                      "example": 54200.50
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}