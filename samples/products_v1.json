{
  "openapi": "3.0.0",
  "info": {
    "title": "E-Commerce Product Catalog Service",
    "version": "1.0.0",
    "description": "Legacy Products Catalog API"
  },
  "paths": {
    "/products": {
      "get": {
        "summary": "Retrieve catalog products",
        "operationId": "getProducts",
        "responses": {
          "200": {
            "description": "Product object",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "integer",
                      "example": 101
                    },
                    "title": {
                      "type": "string",
                      "example": "Wireless Mouse"
                    },
                    "price": {
                      "type": "number",
                      "example": 29.99
                    }
                  },
                  "required": ["id", "title", "price"]
                }
              }
            }
          }
        }
      }
    }
  }
}
