{
  "openapi": "3.0.0",
  "info": {
    "title": "User Service",
    "version": "1.0.0",
    "description": "Legacy User Management API"
  },
  "paths": {
    "/users": {
      "get": {
        "summary": "Get all users",
        "operationId": "getUsers",
        "responses": {
          "200": {
            "description": "A list of users or user object",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "integer",
                      "example": 1
                    },
                    "name": {
                      "type": "string",
                      "example": "Sugam"
                    }
                  },
                  "required": ["id", "name"]
                }
              }
            }
          }
        }
      }
    }
  }
}
